# Copy to .env and adjust. Empty values keep the defaults from docker-compose.yml.

# --- machine: fake module (default) or real ito ---
# Fake: run with "docker compose --profile fake up -d"
CAPTURE=replay.txt          # file in ./captures, recorded with tools/capture.py
SPEED=1                     # replay speed factor
FROM=0                      # start offset in the capture, s
#TO=600                     # end offset in the capture, s
# Real machine: uncomment, start without --profile fake.
# Caution: on (re)connect the bridge sends MCcREPORT SP1 (machine beeps), and a second
# telnet client next to a production bridge is not verified.
#MACHINE_HOST=192.168.x.y
#MACHINE_PORT=23
MACHINE_NAME=Silvia Test

# --- MQTT: own test broker (default) or the Home Assistant broker ---
# With the HA broker the test device shows up in HA as "Silvia Test".
#MQTT_HOST=192.168.x.y
#MQTT_USERNAME=
#MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=leva2mqtt-test

# --- optional ---
#VISUALIZER_USERNAME=
#VISUALIZER_PASSWORD=
#SHOTS_GRINDERS=Niche Zero,DF64      # "Grinder" select in HA, see docs/visualizer.md
#SHOTS_KEEP=true                    # keep shot files after upload (in the data volume, shots/)
#CAPTURE_ENABLED=false              # raw capture is on in the test stack; fetch with tools/fetch-captures.sh
#CAPTURE_KEEP_DAYS=7
#TELEGRAM_TOKEN=
#TELEGRAM_CHAT_ID=
#TELEGRAM_LANGUAGE=de               # message language: en (default) or de
LOG_LEVEL=DEBUG
